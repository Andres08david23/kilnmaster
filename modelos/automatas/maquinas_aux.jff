<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!-- Estados de Máquinas Auxiliares (Molienda, Extrusora, Cortadora) -->
		<state id="0" name="Lista">
			<x>140.0</x>
			<y>180.0</y>
			<initial/>
			<final/>
		</state>
		<state id="1" name="Operando">
			<x>340.0</x>
			<y>100.0</y>
		</state>
		<state id="2" name="Falla">
			<x>340.0</x>
			<y>260.0</y>
		</state>
		<!-- Transiciones de Operación y Falla -->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>i</read>
		</transition>
		<transition>
			<from>1</from>
			<to>0</to>
			<read>f</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>a</read>
		</transition>
		<transition>
			<from>2</from>
			<to>0</to>
			<read>r</read>
		</transition>
	</automaton>
</structure>
